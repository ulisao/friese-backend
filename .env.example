# ==========================================
# CONFIGURACIÓN DEL SERVIDOR
# ==========================================
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# ==========================================
# BASE DE DATOS (PostgreSQL)
# ==========================================
DATABASE_URL=postgresql://usuario:password@localhost:5432/friese_db

# ==========================================
# STORAGE (AWS S3 / Cloudflare R2 para Evidencia)
# ==========================================
S3_BUCKET_NAME=friese-evidencia
S3_ACCESS_KEY=tu_access_key
S3_SECRET_KEY=tu_secret_key
S3_REGION=us-east-1
S3_ENDPOINT=https://tu-endpoint-r2.cloudflarestorage.com # Opcional si usás R2

# ==========================================
# SEGURIDAD Y HASHES
# ==========================================
JWT_SECRET=super_secret_key_para_operarios
HASH_SALT_ROUNDS=10

# ==========================================
# PROVEEDOR SMS (Validación del Fletista)
# ==========================================
SMS_API_KEY=tu_api_key_de_twilio_o_messagebird
SMS_SENDER_ID=FrieseApp
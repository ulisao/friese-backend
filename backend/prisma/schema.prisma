generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum ShipmentStatus {
  PENDING_EVIDENCE
  IN_TRANSIT
  DELIVERED
  CLOSED
  DISPUTE
  DISPUTE_RESOLVED
}

enum EvidenceType {
  DEPARTURE
  COMPLAINT
}

enum ReceiverActionType {
  CONFIRMED
  DISPUTED
}

enum UsageEventType {
  SHIPMENT_CREATED
  EMAIL_SENT
  EVIDENCE_UPLOADED
}

// ---------------------------------------------------------------------------
// Core entities
// ---------------------------------------------------------------------------

model Company {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique @db.VarChar(255)
  passwordHash String       @map("password_hash") @db.VarChar(255)
  name         String       @db.VarChar(255)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  devices      Device[]
  shipments    Shipment[]
  usageEvents  UsageEvent[]

  @@map("companies")
}

model Device {
  id           String     @id @default(uuid()) @db.Uuid
  companyId    String     @map("company_id") @db.Uuid
  company      Company    @relation(fields: [companyId], references: [id])
  operatorName String     @map("operator_name") @db.VarChar(255)
  tokenHash    String     @map("token_hash") @db.VarChar(64)
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at")
  revokedAt    DateTime?  @map("revoked_at")
  shipments    Shipment[]

  @@map("devices")
}

// ---------------------------------------------------------------------------
// Shipment & related
// ---------------------------------------------------------------------------

model Shipment {
  id              String          @id @default(uuid()) @db.Uuid
  trackingCode    String          @unique @map("tracking_code") @db.VarChar(100)
  // trackingToken eliminado — el acceso del receptor ahora vive en ReceiverLink
  status          ShipmentStatus  @default(PENDING_EVIDENCE)
  companyId       String          @map("company_id") @db.Uuid
  company         Company         @relation(fields: [companyId], references: [id])
  createdByDevice String?         @map("created_by_device") @db.Uuid
  device          Device?         @relation(fields: [createdByDevice], references: [id])
  receiverEmail   String          @map("receiver_email") @db.VarChar(255)
  destinatario    String          @db.VarChar(255)
  metadata        Json?
  // Timestamp exacto desde donde corre el reloj de 72hs hábiles
  // Se setea cuando el admin marca el envío como DELIVERED
  deliveredAt     DateTime?       @map("delivered_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  items           ShipmentItem[]
  evidence        Evidence[]
  disputeTokens   DisputeToken[]
  auditLogs       AuditLog[]
  receiverAction  ReceiverAction?
  receiverLink    ReceiverLink?

  @@map("shipments")
}

// Acceso del receptor al portal de tracking
// Reemplaza trackingToken en Shipment — ahora tiene TTL, registro de apertura
// y puede regenerarse sin tocar el Shipment
model ReceiverLink {
  id          String    @id @default(uuid()) @db.Uuid
  shipmentId  String    @unique @map("shipment_id") @db.Uuid
  shipment    Shipment  @relation(fields: [shipmentId], references: [id])
  token       String    @unique @default(uuid()) @db.VarChar(100)
  // Si el admin regenera el link, el anterior se invalida
  invalidated    Boolean   @default(false)
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("receiver_links")
}

model ShipmentItem {
  id          String     @id @default(uuid()) @db.Uuid
  shipmentId  String     @map("shipment_id") @db.Uuid
  shipment    Shipment   @relation(fields: [shipmentId], references: [id])
  descripcion String     @db.VarChar(255)
  lote        String?    @db.VarChar(100)
  cantidad    Int
  marca       String?    @db.VarChar(100)
  material    String?    @db.VarChar(100)
  createdAt   DateTime   @default(now()) @map("created_at")
  evidence    Evidence[]

  @@map("shipment_items")
}

model Evidence {
  id             String         @id @default(uuid()) @db.Uuid
  shipmentId     String         @map("shipment_id") @db.Uuid
  shipment       Shipment       @relation(fields: [shipmentId], references: [id])
  shipmentItemId String?        @map("shipment_item_id") @db.Uuid
  shipmentItem   ShipmentItem?  @relation(fields: [shipmentItemId], references: [id])
  fileUrl        String         @map("file_url")
  fileHash       String         @map("file_hash") @db.VarChar(64)
  fileSizeBytes  Int?           @map("file_size_bytes")
  metadataJson   Json           @map("metadata_json")
  type           EvidenceType
  createdAt      DateTime       @default(now()) @map("created_at")
  receiverAction ReceiverAction?

  @@map("evidence")
}

model DisputeToken {
  id             String          @id @default(uuid()) @db.Uuid
  shipmentId     String          @map("shipment_id") @db.Uuid
  shipment       Shipment        @relation(fields: [shipmentId], references: [id])
  visualToken    String          @map("visual_token") @db.VarChar(255)
  generatedAt    DateTime        @default(now()) @map("generated_at")
  expiresAt      DateTime        @map("expires_at")
  usedAt         DateTime?       @map("used_at")
  receiverAction ReceiverAction?

  @@map("dispute_tokens")
}

model ReceiverAction {
  id             String             @id @default(uuid()) @db.Uuid
  shipmentId     String             @unique @map("shipment_id") @db.Uuid
  shipment       Shipment           @relation(fields: [shipmentId], references: [id])
  action         ReceiverActionType
  disputeTokenId String?            @unique @map("dispute_token_id") @db.Uuid
  disputeToken   DisputeToken?      @relation(fields: [disputeTokenId], references: [id])
  evidenceId     String?            @unique @map("evidence_id") @db.Uuid
  evidence       Evidence?          @relation(fields: [evidenceId], references: [id])
  ipAddress      String?            @map("ip_address") @db.VarChar(45)
  createdAt      DateTime           @default(now()) @map("created_at")

  @@map("receiver_actions")
}

model AuditLog {
  id         String          @id @default(uuid()) @db.Uuid
  shipmentId String          @map("shipment_id") @db.Uuid
  shipment   Shipment        @relation(fields: [shipmentId], references: [id])
  fromStatus ShipmentStatus? @map("from_status")
  toStatus   ShipmentStatus  @map("to_status")
  actor      String          @db.VarChar(255)
  timestamp  DateTime        @default(now())

  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Metering
// ---------------------------------------------------------------------------

model UsageEvent {
  id        String         @id @default(uuid()) @db.Uuid
  companyId String         @map("company_id") @db.Uuid
  company   Company        @relation(fields: [companyId], references: [id])
  type      UsageEventType
  metadata  Json?
  createdAt DateTime       @default(now()) @map("created_at")

  @@index([companyId, createdAt])
  @@index([companyId, type])
  @@map("usage_events")
}
